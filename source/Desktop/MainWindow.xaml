<Window x:Class="ReadAloudStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ReadAloudStudio" Title="{DynamicResource Ui.WindowTitle}"
        Width="1140" Height="780" MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" Foreground="{StaticResource Ink}" Background="{StaticResource PageSurface}"
        UseLayoutRounding="True" Loaded="WindowLoaded" Closing="WindowClosing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="{StaticResource Masthead}" Padding="20,10">
      <DockPanel>
        <Button x:Name="LanguageButton" DockPanel.Dock="Right" Content="English / 中文" Style="{StaticResource Nav}"
                Background="#28534A" Foreground="White" Padding="10,5" Margin="12,0,0,0"
                AutomationProperties.Name="{DynamicResource Ui.LanguageTitle}" ToolTip="{DynamicResource Ui.LanguageHelp}" Click="LanguageClick"/>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,22,0">
          <Border Width="30" Height="30" Background="#D4ECD9" CornerRadius="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Rectangle Width="3" Height="8" Fill="{StaticResource Masthead}" RadiusX="1.5" RadiusY="1.5" Margin="1"/>
              <Rectangle Width="3" Height="17" Fill="{StaticResource Masthead}" RadiusX="1.5" RadiusY="1.5" Margin="1"/>
              <Rectangle Width="3" Height="12" Fill="{StaticResource Masthead}" RadiusX="1.5" RadiusY="1.5" Margin="1"/>
              <Rectangle Width="3" Height="6" Fill="{StaticResource Masthead}" RadiusX="1.5" RadiusY="1.5" Margin="1"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{DynamicResource Ui.AppName}" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="9,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Left" x:Name="Navigation" Orientation="Horizontal">
          <Button x:Name="PracticeNav" Content="{DynamicResource Ui.NavPractice}" Style="{StaticResource Nav}" Click="PracticeClick"/>
          <Button x:Name="CompareNav" Content="{DynamicResource Ui.NavCompare}" Style="{StaticResource Nav}" Click="CompareClick"/>
          <Button x:Name="HistoryNav" Content="{DynamicResource Ui.NavHistory}" Style="{StaticResource Nav}" Click="HistoryClick"/>
        </StackPanel>
        <TextBlock x:Name="DeviceLabel" Text="{DynamicResource Ui.DetectDevice}" Foreground="{StaticResource HeaderText}" FontSize="13"
                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="PageFrame" Margin="20,16" MaxWidth="1360" SizeChanged="PageFrameSizeChanged">
        <StackPanel x:Name="PracticePage">
          <Border x:Name="Editor" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource Ui.EditTitle}"/>
              <WrapPanel x:Name="ExampleChoices" Margin="0,10,0,4"/>
              <TextBox x:Name="SentenceBox" AutomationProperties.Name="{DynamicResource Ui.ReferenceInput}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="7"
                       VerticalScrollBarVisibility="Auto" Padding="9,7" FontSize="16" KeyDown="SentenceKeyDown"/>
              <DockPanel Margin="0,9,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="{DynamicResource Ui.Cancel}" Margin="0,0,7,0" Click="CancelEditClick"/>
                  <Button Content="{DynamicResource Ui.ApplyText}" Style="{StaticResource Primary}" Click="ApplySentenceClick"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{DynamicResource Ui.TextLimits}" TextWrapping="Wrap"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <Grid x:Name="PracticeGrid">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="ReaderColumn">
              <Border x:Name="PracticeCard" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <Button x:Name="ChangeSentence" Content="{DynamicResource Ui.ChangeText}" DockPanel.Dock="Right" Padding="10,4" Click="EditSentenceClick"/>
                    <Button x:Name="ReturnPassage" DockPanel.Dock="Right" Content="{DynamicResource Ui.BackToPassage}" ContentTemplate="{StaticResource ActionLabel}" Tag="{StaticResource IconBack}" Visibility="Collapsed" Padding="9,4" Click="ReturnPassageClick"/>
                    <TextBlock x:Name="ReadingHeading" Style="{StaticResource PanelTitle}" Text="{DynamicResource Ui.ReadingText}" TextWrapping="Wrap"/>
                  </DockPanel>
                  <WrapPanel x:Name="PassageNav" Visibility="Collapsed" Margin="0,10,0,0">
                    <local:SentenceNavigator x:Name="PracticeNavigator" Margin="0,0,12,2"/>
                    <TextBlock x:Name="PassageSummary" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </WrapPanel>
                  <Border Background="{StaticResource SoftSurface}" CornerRadius="6" Padding="11,8" Margin="0,10,0,10">
                    <ScrollViewer x:Name="ReaderScroll" MaxHeight="210" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel>
                        <TextBlock x:Name="ReaderText" FontFamily="Georgia" FontSize="32" TextWrapping="Wrap"/>
                        <WrapPanel x:Name="SentenceWords"/>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                  <StackPanel x:Name="OriginalSound" Visibility="Collapsed" Margin="0,0,0,8">
                    <DockPanel>
                      <TextBlock x:Name="RangeText" DockPanel.Dock="Right" Style="{StaticResource Caption}"/>
                      <TextBlock Text="{DynamicResource Ui.OriginalAudio}" Style="{StaticResource Caption}"/>
                    </DockPanel>
                    <Canvas x:Name="Wave" Height="30" ClipToBounds="True" SizeChanged="WaveSizeChanged"/>
                    <WrapPanel Margin="0,3,0,0">
                      <Button x:Name="PlayWhole" Content="{DynamicResource Ui.PlayOriginal}" Tag="{StaticResource IconHeadphones}" ContentTemplate="{StaticResource ActionLabel}" Click="PlayWholeClick" Padding="9,3" Margin="0,0,6,3"/>
                      <Button x:Name="PlaySentence" Content="{DynamicResource Ui.PlaySection}" Tag="{StaticResource IconPlay}" ContentTemplate="{StaticResource ActionLabel}" Visibility="Collapsed" Click="PlaySentenceClick" Padding="9,3" Margin="0,0,6,3"/>
                    </WrapPanel>
                  </StackPanel>
                  <WrapPanel>
                    <Button x:Name="RecordButton" Content="{DynamicResource Ui.StartRecording}" Style="{StaticResource Primary}" Tag="{StaticResource IconMic}" ContentTemplate="{StaticResource ActionLabel}" Click="RecordClick" Margin="0,0,6,4"/>
                    <Button x:Name="RetakeButton" Content="{DynamicResource Ui.RetakeOnly}" Style="{StaticResource TintButton}" Tag="{StaticResource IconRetake}" ContentTemplate="{StaticResource ActionLabel}" Click="RetakeClick" Visibility="Collapsed" Margin="0,0,6,4"/>
                    <Button x:Name="ImportButton" Content="{DynamicResource Ui.ImportOwnTake}" Tag="{StaticResource IconImport}" ContentTemplate="{StaticResource ActionLabel}" Click="ImportClick" Margin="0,0,6,4"/>
                    <Button x:Name="RetryButton" Content="{DynamicResource Ui.RetryScoring}" Click="RetryClick" Visibility="Collapsed" Margin="0,0,6,4"/>
                  </WrapPanel>
                  <ProgressBar x:Name="MicMeter" Style="{StaticResource Meter}" Margin="0,5,0,2" Minimum="0" Maximum="1"
                               Visibility="Collapsed" AutomationProperties.Name="{DynamicResource Ui.InputLevel}"/>
                  <Expander x:Name="MicSettings" Margin="0,7,0,0" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                      <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis">
                        <Run Text="{DynamicResource Ui.Microphone}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run x:Name="MicDeviceName" Text="{DynamicResource Ui.NoMicSelected}"/>
                      </TextBlock>
                    </Expander.Header>
                    <DockPanel Margin="0,7,0,0">
                      <Button x:Name="RefreshMic" DockPanel.Dock="Right" Content="{DynamicResource Ui.Refresh}" Margin="7,0,0,0" Click="RefreshMicClick"/>
                      <ComboBox x:Name="MicBox" AutomationProperties.Name="{DynamicResource Ui.Microphone}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="MicChanged"/>
                    </DockPanel>
                  </Expander>
                </StackPanel>
              </Border>
              <Border x:Name="RetakePanel" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Style="{StaticResource PanelTitle}" Text="{DynamicResource Ui.RetakeComparison}"/>
                  <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource SoftSurface}" CornerRadius="4" Padding="7,3" VerticalAlignment="Top" Margin="0,0,9,0">
                      <TextBlock Text="{DynamicResource Ui.OriginalTakeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Muted}" FontSize="13"/>
                    </Border>
                    <TextBlock x:Name="BaselineDetail" Grid.Column="1" TextWrapping="Wrap"/>
                    <Border Grid.Row="1" Background="{StaticResource AccentSoft}" CornerRadius="4" Padding="7,3" VerticalAlignment="Top" Margin="0,9,9,0">
                      <TextBlock Text="{DynamicResource Ui.SentenceTakeLabel}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" FontSize="13"/>
                    </Border>
                    <TextBlock x:Name="RetakeDetail" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,9,0,0"/>
                  </Grid>
                  <WrapPanel>
                    <Button x:Name="PlayBaseline" Content="{DynamicResource Ui.BaselinePlay}" Tag="{StaticResource IconPlay}" ContentTemplate="{StaticResource ActionLabel}" Click="BaselineClick" Margin="0,0,6,4"/>
                    <Button x:Name="PlayRetakePair" Content="{DynamicResource Ui.BaselinePair}" Tag="{StaticResource IconHeadphones}" ContentTemplate="{StaticResource ActionLabel}" Click="RetakePairClick" Margin="0,0,6,4"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border x:Name="PreviewPanel" Style="{StaticResource Card}" Visibility="Collapsed" Margin="0,12,0,0">
                <StackPanel>
                  <DockPanel>
                    <Button x:Name="ExpandPreview" Content="{DynamicResource Ui.ExpandText}" DockPanel.Dock="Right" Padding="9,3" Visibility="Collapsed" Click="ExpandPreviewClick"/>
                    <TextBlock x:Name="PreviewHeading" Text="{DynamicResource Ui.FullTextPreview}" Style="{StaticResource PanelTitle}"/>
                  </DockPanel>
                  <WrapPanel Margin="0,7,0,9">
                    <TextBlock x:Name="PreviewHint" Style="{StaticResource Caption}" Margin="0,0,10,2" Text="{DynamicResource Ui.JumpHint}"/>
                    <TextBlock x:Name="PronunciationLegend" Style="{StaticResource Caption}" Margin="0,0,8,2" Padding="3,0"
                               Foreground="{StaticResource PronunciationInk}" Background="{StaticResource PronunciationFill}" TextDecorations="Underline" Visibility="Collapsed"/>
                    <TextBlock x:Name="MissingWordLegend" Style="{StaticResource Caption}" Margin="0,0,8,2" Padding="3,0" Foreground="{StaticResource ReviewInk}"
                               Background="{StaticResource ReviewFill}" TextDecorations="Strikethrough" ToolTip="{DynamicResource Ui.MissingHelp}" Visibility="Collapsed"/>
                    <TextBlock x:Name="ReviewLegend" Style="{StaticResource Caption}" Foreground="{StaticResource ReviewInk}"
                               TextDecorations="Underline" Visibility="Collapsed" Text="{DynamicResource Ui.SentenceReviewLegend}"/>
                  </WrapPanel>
                  <ScrollViewer x:Name="PreviewScroll" ScrollChanged="PreviewScrollChanged" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="PreviewText" FontSize="17" LineHeight="27" FontFamily="Georgia, Segoe UI" TextWrapping="Wrap"/>
                  </ScrollViewer>
                </StackPanel>
              </Border>
              <Border x:Name="TranscriptCard" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="15,10">
                <Expander x:Name="TranscriptDetails" HorizontalContentAlignment="Stretch">
                  <Expander.Header><TextBlock x:Name="TranscriptHeading" Text="{DynamicResource Ui.TranscriptTitle}" FontWeight="SemiBold"/></Expander.Header>
                  <StackPanel Margin="2,8,0,0">
                    <TextBlock x:Name="Transcript" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TextDiff" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <Expander x:Name="FullDetails" Header="{DynamicResource Ui.FullTranscript}" Visibility="Collapsed" Margin="0,7,0,0">
                      <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="FullText" TextWrapping="Wrap" Margin="4,7"/></ScrollViewer>
                    </Expander>
                  </StackPanel>
                </Expander>
              </Border>
            </StackPanel>
            <StackPanel x:Name="FeedbackColumn" Grid.Column="2">
              <Border x:Name="FeedbackCard" Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <Button x:Name="NextMarked" Content="{DynamicResource Ui.NextFlag}" Style="{StaticResource TintButton}" DockPanel.Dock="Right" Padding="9,4"
                            Visibility="Collapsed" Click="NextMarkedClick" ToolTip="{DynamicResource Ui.NextFlagHelp}"/>
                    <TextBlock Text="{DynamicResource Ui.FeedbackTitle}" Style="{StaticResource PanelTitle}" TextWrapping="Wrap"/>
                  </DockPanel>
                  <TextBlock x:Name="FocusWord" Text="{DynamicResource Ui.SelectWord}" FontSize="36" FontFamily="Georgia, Microsoft YaHei UI"
                             AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Margin="0,9,0,0"/>
                  <TextBlock x:Name="FocusIpa" FontSize="16" Foreground="{StaticResource Accent}" TextWrapping="Wrap"
                             ToolTip="{DynamicResource Ui.VoiceIpaHelp}"/>
                  <TextBlock x:Name="ScoringIpa" Style="{StaticResource Caption}" Visibility="Collapsed" TextWrapping="Wrap"/>
                  <WrapPanel x:Name="PhoneDetails" Margin="0,7,0,0"/>
                  <Border x:Name="FeedbackCallout" Background="{StaticResource SoftSurface}" BorderBrush="{StaticResource Line}"
                          BorderThickness="3,0,0,0" Padding="10,6" Margin="0,7,0,8">
                    <TextBlock x:Name="FeedbackText" TextWrapping="Wrap" LineHeight="21"/>
                  </Border>
                  <WrapPanel>
                    <Button x:Name="PlayWord" Content="{DynamicResource Ui.PlayWord}" Tag="{StaticResource IconHeadphones}" ContentTemplate="{StaticResource ActionLabel}" Click="PlayWordClick" Margin="0,0,6,4"/>
                    <Button x:Name="PlayWordExample" Content="{DynamicResource Ui.WordExample}" Tag="{StaticResource IconSpeaker}" ContentTemplate="{StaticResource ActionLabel}" Style="{StaticResource TintButton}" ToolTip="{DynamicResource Ui.WordExampleHelp}" Click="PlayWordExampleClick" Margin="0,0,6,4"/>
                    <Button x:Name="PlayContext" Content="{DynamicResource Ui.HearContext}" Tag="{StaticResource IconContext}" ContentTemplate="{StaticResource ActionLabel}" Style="{StaticResource TintButton}" Click="ContextClick" Margin="0,0,0,4"/>
                  </WrapPanel>
                  <Button x:Name="PlayExtra" Content="{DynamicResource Ui.PlayExtra}" Click="PlayExtraClick" HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="15,12">
                <StackPanel>
                  <DockPanel>
                    <Button x:Name="ImportModel" Content="{DynamicResource Ui.ImportModel}" DockPanel.Dock="Right" Tag="{StaticResource IconMusic}" ContentTemplate="{StaticResource ActionLabel}" Padding="8,3" Click="ImportModelClick"/>
                    <TextBlock Text="{DynamicResource Ui.ReferenceRecording}" Style="{StaticResource PanelTitle}"/>
                  </DockPanel>
                  <ComboBox x:Name="VoiceBox" DisplayMemberPath="Label" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="{DynamicResource Ui.ReferenceRecording}" Margin="0,8,0,7" ToolTip="{DynamicResource Ui.SourceHelp}"/>
                  <WrapPanel>
                    <Button x:Name="PlayExample" Content="{DynamicResource Ui.ExampleSentence}" Tag="{StaticResource IconPlay}" ContentTemplate="{StaticResource ActionLabel}" Click="ExampleClick" Margin="0,0,6,4"/>
                    <Button x:Name="PlayModelSentence" Content="{DynamicResource Ui.ExampleSentence}" Tag="{StaticResource IconSpeaker}" ContentTemplate="{StaticResource ActionLabel}" Visibility="Collapsed" Click="ModelSentenceClick" Margin="0,0,6,4"/>
                  </WrapPanel>
                  <TextBlock x:Name="SourceCoverage" Style="{StaticResource Caption}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border x:Name="ScoreCard" Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock x:Name="ScoreTitle" Text="{DynamicResource Ui.ReadingScore}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <Grid x:Name="ScoresPanel" Margin="0,10,0,7" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="7" Padding="12,5" MinWidth="70" Margin="0,0,14,0">
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{DynamicResource Ui.Total}" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" FontSize="13"/>
                        <TextBlock x:Name="Total" FontSize="31" FontWeight="SemiBold" Foreground="{StaticResource Masthead}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                      <TextBlock Text="{DynamicResource Ui.Accuracy}" Style="{StaticResource Caption}"/>
                      <TextBlock Grid.Row="1" Text="{DynamicResource Ui.Fluency}" Style="{StaticResource Caption}"/>
                      <TextBlock Grid.Row="2" Text="{DynamicResource Ui.Prosody}" Style="{StaticResource Caption}"/>
                      <ProgressBar x:Name="AccuracyBar" Grid.Column="1" Style="{StaticResource Meter}" Margin="9,0" AutomationProperties.Name="{DynamicResource Ui.Accuracy}"/>
                      <ProgressBar x:Name="FluencyBar" Grid.Row="1" Grid.Column="1" Style="{StaticResource Meter}" Margin="9,0" AutomationProperties.Name="{DynamicResource Ui.Fluency}"/>
                      <ProgressBar x:Name="ProsodyBar" Grid.Row="2" Grid.Column="1" Style="{StaticResource Meter}" Margin="9,0" AutomationProperties.Name="{DynamicResource Ui.Prosody}"/>
                      <TextBlock x:Name="Accuracy" Grid.Column="2" FontSize="15" FontWeight="SemiBold" TextAlignment="Right"/>
                      <TextBlock x:Name="Fluency" Grid.Row="1" Grid.Column="2" FontSize="15" FontWeight="SemiBold" TextAlignment="Right"/>
                      <TextBlock x:Name="Prosody" Grid.Row="2" Grid.Column="2" FontSize="15" FontWeight="SemiBold" TextAlignment="Right"/>
                    </Grid>
                  </Grid>
                  <TextBlock x:Name="ScoreNote" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  <Button x:Name="RescoreBritish" Content="{DynamicResource Ui.RescoreBritish}" Click="RescoreBritishClick" HorizontalAlignment="Left"
                          Margin="0,7,0,0" Visibility="Collapsed" ToolTip="{DynamicResource Ui.RescoreHelp}"/>
                  <TextBlock x:Name="PauseSummary" Style="{StaticResource Caption}" TextWrapping="Wrap" LineHeight="20" Margin="0,5,0,0"
                             ToolTip="{DynamicResource Ui.PauseHelp}"/>
                  <Expander Header="{DynamicResource Ui.ScoringBasis}" Margin="0,7,0,0">
                    <TextBlock x:Name="ScoreBasis" Margin="3,5" TextWrapping="Wrap" LineHeight="21" Style="{StaticResource Caption}"/>
                  </Expander>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
        <StackPanel x:Name="ComparePage" Visibility="Collapsed">
          <TextBlock Text="{DynamicResource Ui.CompareTitle}" Style="{StaticResource PanelTitle}"/>
          <TextBlock x:Name="CompareReference" FontFamily="Georgia" FontSize="27" Margin="0,7,0,12" MaxHeight="104" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"/>
          <TextBlock x:Name="CompareEmpty" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <StackPanel x:Name="CompareControls">
            <local:SentenceNavigator x:Name="CompareNavigator" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <TextBlock Text="{DynamicResource Ui.PlaybackRange}" Style="{StaticResource Caption}"/>
            <WrapPanel x:Name="CompareWords" Margin="0,5,0,9"/>
            <UniformGrid x:Name="ComparePair" Columns="2">
              <Border x:Name="CompareACard" Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel>
                <TextBlock Text="{DynamicResource Ui.TakeA}" FontWeight="SemiBold"/>
                <ComboBox x:Name="CompareA" AutomationProperties.Name="{DynamicResource Ui.TakeA}" DisplayMemberPath="Label" Margin="0,7,0,10" SelectionChanged="CompareSelectionChanged"/>
                <TextBlock x:Name="AWord" FontSize="25" FontFamily="Georgia, Microsoft YaHei UI" TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ADetail" LineHeight="22" TextWrapping="Wrap" Margin="0,5,0,10"/></ScrollViewer>
                <Button x:Name="APlay" Content="{DynamicResource Ui.PlayA}" HorizontalAlignment="Left" Click="APlayClick"/>
              </StackPanel></Border>
              <Border x:Name="CompareBCard" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel>
                <TextBlock Text="{DynamicResource Ui.TakeB}" FontWeight="SemiBold"/>
                <ComboBox x:Name="CompareB" AutomationProperties.Name="{DynamicResource Ui.TakeB}" DisplayMemberPath="Label" Margin="0,7,0,10" SelectionChanged="CompareSelectionChanged"/>
                <TextBlock x:Name="BWord" FontSize="25" FontFamily="Georgia, Microsoft YaHei UI" TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="BDetail" LineHeight="22" TextWrapping="Wrap" Margin="0,5,0,10"/></ScrollViewer>
                <Button x:Name="BPlay" Content="{DynamicResource Ui.PlayB}" HorizontalAlignment="Left" Click="BPlayClick"/>
              </StackPanel></Border>
            </UniformGrid>
            <Button x:Name="PlayPair" Content="{DynamicResource Ui.PlayPair}" HorizontalAlignment="Left" Style="{StaticResource Primary}" Margin="0,13,0,0" Click="PairClick"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
          <TextBlock Text="{DynamicResource Ui.NavHistory}" Style="{StaticResource PanelTitle}"/>
          <TextBlock x:Name="HistoryCaption" Style="{StaticResource Caption}" Margin="0,5,0,14"/>
          <StackPanel x:Name="HistoryRows"/>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,6">
      <DockPanel>
        <Button x:Name="StopSound" DockPanel.Dock="Right" Content="{DynamicResource Ui.StopPlayback}" Tag="{StaticResource IconStop}" ContentTemplate="{StaticResource ActionLabel}" Padding="8,3" Margin="10,0,0,0" Click="StopSoundClick" Visibility="Collapsed"/>
        <TextBlock x:Name="Status" Text="{DynamicResource Ui.StartingService}" Style="{StaticResource Caption}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
